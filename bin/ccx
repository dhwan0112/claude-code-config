#!/usr/bin/env bash
# ccx: open Claude Code in a tmux workspace on a separate tmux server (tmux -L cc).
# Layouts (CCX_LAYOUT):
#   sidebar (default): left top claude · left bottom diff (CCX_DIFF, default 22%, at least 6 rows) · right
#                      full-height status panel (CCX_SIDEBAR, default 22%, at least 36 columns)
#   split:             left claude · right top status panel (14 rows) · right bottom diff
# Usage: ccx [--safe] [claude arguments...]
#        ccx --save-tabs [NAME] | --restore-tabs [NAME] | --list-tabs      (tab sets, see below)
#   New tabs start in bypass permission mode (permissions.defaultMode in ccx's --settings). ccx --safe or
#   CCX_SAFE=1 leaves it out, so the user's global defaultMode applies. A --permission-mode or
#   --dangerously-skip-permissions flag given to ccx goes to claude unchanged and wins (no bypass default added).
#   ccx's --settings also adds "ask" rules for destructive git/gh commands (see ccx_settings.py).
#   Run outside tmux: creates or attaches to session "cc" and adds a new tab (window).
#   Run inside the cc server (or C-a c): adds a tab and switches to it.
#   Run inside another tmux server: adds the tab, renames that outer window to "ccx · <active tab>" (that
#   window only; automatic-rename off for it) and prints the attach command.
# Env: CCX_SAFE=1 (same as --safe), CCX_NO_ATTACH=1 (do not attach), CCX_SELECT=1 (select the new tab), CCX_SIZE=WxH (size of a new
#      detached server), CCX_SOCKET=name (tmux -L socket, default cc), CCX_LAYOUT, CCX_SIDEBAR, CCX_DIFF,
#      CCX_HOME (folder with the cc-panel scripts, default ~/.claude/cc-panel; for testing a copy), CCX_TABNAME (first name
#      of the new tab instead of repo:branch / folder; used by --restore-tabs).
# Defaults file: ~/.config/cc-panel/config ($XDG_CONFIG_HOME/cc-panel/config), lines KEY=value for
#      CCX_LAYOUT, CCX_SIDEBAR, CCX_DIFF. Environment variables win. C-a w writes it (savesize.sh).
set -euo pipefail

P=${CCX_HOME:-$HOME/.claude/cc-panel}
D="$HOME/.cache/cc-panel"
SOCK=${CCX_SOCKET:-cc}
[[ "$SOCK" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "ccx: bad CCX_SOCKET" >&2; exit 2; }
[ -d "$P" ] || { echo "ccx: no such folder: $P (CCX_HOME)" >&2; exit 2; }
tm() { tmux -L "$SOCK" -f "$P/tmux.conf" "$@"; }

# Defaults file: only these keys, values letters/digits/./% only, no shell evaluation. Env wins.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/cc-panel/config"
if [ -f "$cfg" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}; line=${line//[[:space:]]/}
    [[ "$line" =~ ^(CCX_LAYOUT|CCX_SIDEBAR|CCX_DIFF|CCX_TUI)=([A-Za-z0-9.%]+)$ ]] || continue
    k=${BASH_REMATCH[1]}
    [ -n "${!k:-}" ] || printf -v "$k" '%s' "${BASH_REMATCH[2]}"
  done < "$cfg"
fi
# Renderer of the Claude pane (CCX_TUI): fullscreen (default: prompt fixed at the bottom, the mouse wheel scrolls the conversation
# inside Claude Code), default (Claude Code's classic renderer: the wheel enters tmux copy mode and the whole pane scrolls) or user
# (no "tui" key, ~/.claude/settings.json decides). Passed to ccx_settings.py and to left.sh, which sets CLAUDE_CODE_NO_FLICKER from it.
# Not exported: a tmux server started here would otherwise hand it to every later ccx run and the config file would stop applying.
case "${CCX_TUI:-fullscreen}" in
  fullscreen|default|user) CCX_TUI=${CCX_TUI:-fullscreen} ;;
  classic) CCX_TUI=default ;;
  *) echo "ccx: CCX_TUI=$CCX_TUI is not fullscreen, default or user; using fullscreen" >&2; CCX_TUI=fullscreen ;;
esac

# Tab sets. "ccx --save-tabs [NAME]" writes the open tabs of this server (savetabs.sh: tab name, project folder, Claude Code
# session id, permissions, layout) to ${XDG_CONFIG_HOME:-~/.config}/cc-panel/tabs/<socket>/NAME.tsv; "ccx --restore-tabs [NAME]"
# opens one tab per line again, in order, each with "claude --resume <session id>" in its project folder (a tab whose session
# is already open is skipped, a missing folder is skipped with a message, a session whose transcript is gone starts anew);
# "ccx --list-tabs" lists the sets. NAME defaults to "last", which ccx (tab opened), left.sh (tab closed) and the tmux hooks
# in tmux.conf (tab renamed or selected, client detached) keep up to date, so after a reboot "ccx --restore-tabs" is enough.
tabsdir="${XDG_CONFIG_HOME:-$HOME/.config}/cc-panel/tabs/$SOCK"
hint=""
self=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
case "${1:-}" in
  --save-tabs|--restore-tabs)
    setname=${2:-last}
    [[ "$setname" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "ccx: tab set name: letters, digits, - and _ only" >&2; exit 2; }
    [ $# -le 2 ] || { echo "ccx: $1 takes at most one argument (the set name)" >&2; exit 2; }
    if [ "$1" = --save-tabs ]; then
      tm has-session -t "=cc" 2>/dev/null || { echo "ccx: no ccx server on socket $SOCK; nothing to save" >&2; exit 1; }
      exec "$P/savetabs.sh" "$SOCK" "$setname"
    fi
    f="$tabsdir/$setname.tsv"
    [ -f "$f" ] || { echo "ccx: no saved tab set '$setname' ($f); see ccx --list-tabs" >&2; exit 1; }
    mapfile -t setlines < "$f"
    # Sessions already open on any server of this user are not opened twice
    livesids=""
    for s in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
      [ -S "$s" ] || continue
      for lid in $(tmux -S "$s" list-windows -a -F '#{@ccx_id}' 2>/dev/null); do
        [ -f "$D/$lid.json" ] && livesids+=$(jq -r '.session_id // ""' "$D/$lid.json" 2>/dev/null || true)$'\n'
      done
    done
    size=${CCX_SIZE:-}
    [ -n "$size" ] || { [ -z "${TMUX:-}" ] && [ -t 1 ] && size="$(tput cols)x$(tput lines)"; } || true
    opened=0; skipped=0
    for line in "${setlines[@]}"; do
      case "$line" in '#'*|'') continue ;; esac
      IFS=$'\t' read -r tname pdir sid perm tlayout _ <<<"$line"
      [ -n "$pdir" ] || continue
      if [ ! -d "$pdir" ]; then echo "ccx: $tname: folder $pdir is missing, tab skipped"; skipped=$((skipped + 1)); continue; fi
      resume=()
      if [[ "$sid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
        if grep -qxF -- "$sid" <<<"$livesids"; then echo "ccx: $tname: session $sid is already open, tab skipped"; skipped=$((skipped + 1)); continue; fi
        slug=$(printf '%s' "$pdir" | sed 's/[^A-Za-z0-9]/-/g')
        if [ -f "$HOME/.claude/projects/$slug/$sid.jsonl" ] \
           || [ -n "$(find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name "$sid.jsonl" -print -quit 2>/dev/null)" ]; then
          resume=(--resume "$sid")
        else
          echo "ccx: $tname: session $sid has no transcript any more; opening a new session in $pdir"
        fi
      fi
      safeflag=(); [ "$perm" = safe ] && safeflag=(--safe)
      case "$tlayout" in sidebar|split) ;; *) tlayout=sidebar ;; esac
      if (cd "$pdir" && CCX_TABNAME=$tname CCX_SAFE= CCX_SOCKET=$SOCK CCX_HOME=$P CCX_LAYOUT=$tlayout CCX_NO_ATTACH=1 CCX_SIZE=${size:-} \
            "$self" "${safeflag[@]}" "${resume[@]}" >/dev/null); then
        opened=$((opened + 1))
      else
        echo "ccx: $tname: could not open a tab in $pdir"; skipped=$((skipped + 1))
      fi
    done
    [ "$((opened + skipped))" -gt 0 ] || echo "ccx: tab set '$setname' is empty (its last tab was closed on purpose)"
    echo "ccx: tab set '$setname': $opened tab(s) opened, $skipped skipped"
    [ "$opened" -gt 0 ] || exit 1
    "$P/outer-title.sh" "$SOCK" 2>/dev/null || true
    if [ -n "${CCX_NO_ATTACH:-}" ] || [ -n "${TMUX:-}" ]; then
      case "${TMUX:-}" in */"$SOCK",*) ;; "") ;; *) echo "  attach with: TMUX= tmux -L $SOCK attach -t cc" ;; esac
      exit 0
    fi
    exec tmux -L "$SOCK" -f "$P/tmux.conf" attach-session -t "=cc"
    ;;
  --list-tabs)
    [ $# -le 1 ] || { echo "ccx: --list-tabs takes no argument" >&2; exit 2; }
    found=0
    for f in "$tabsdir"/*.tsv; do
      [ -f "$f" ] || continue
      found=1; b=$(basename "$f" .tsv)
      printf '%s (%s tab(s), %s): %s\n' "$b" "$(grep -c -v '^#' "$f")" "$(date -r "$f" '+%Y-%m-%d %H:%M')" \
        "$(grep -v '^#' "$f" | cut -f1 | paste -sd ',' - | sed 's/,/, /g')"
    done
    [ "$found" = 1 ] || echo "ccx: no saved tab sets in $tabsdir (C-a W or ccx --save-tabs writes one)"
    exit 0
    ;;
esac

layout=${CCX_LAYOUT:-sidebar}
case "$layout" in sidebar|split) ;; *) echo "ccx: CCX_LAYOUT must be sidebar or split" >&2; exit 2 ;; esac

# "30%" or "22.5%" -> percent of total (rounded), "40" -> absolute cells
cells() {
  local spec=$1 total=$2
  if [[ "$spec" =~ ^([0-9]+)(\.([0-9]))?%$ ]]; then
    echo $(( (total * (BASH_REMATCH[1] * 10 + ${BASH_REMATCH[3]:-0}) + 500) / 1000 ))
  elif [[ "$spec" =~ ^[0-9]+$ ]]; then echo "$spec"
  else echo "ccx: bad size '$spec' (use N, N% or N.N%)" >&2; exit 2; fi
}

dir=$PWD
if top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
  br=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "-")
  name="$(basename "$top"):$br"
else
  name=$(basename "$dir")
fi
# CCX_TABNAME (ccx --restore-tabs): the saved tab name instead; cleaned like statusline-tee.sh cleans session names
if [ -n "${CCX_TABNAME:-}" ]; then
  t=$(printf '%s' "$CCX_TABNAME" | tr -d '\000-\037\177#;"'"'"'\\$`{}' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [ -n "$t" ] && name=$t
fi

id="$(date +%Y%m%d%H%M%S)-$$-$RANDOM"

# Separate the user's --settings (merged into ours; Claude Code honors only the last --settings flag)
user_settings=""
args=()
safe=0
case "${CCX_SAFE:-}" in ""|0) ;; *) safe=1 ;; esac
userperm=0
while [ $# -gt 0 ]; do
  case "$1" in
    --) args+=("$@"); break ;;
    --safe) safe=1; shift ;;
    --settings) [ $# -ge 2 ] || { echo "ccx: --settings needs a value" >&2; exit 2; }; user_settings=$2; shift 2 ;;
    --settings=*) user_settings=${1#--settings=}; shift ;;
    --permission-mode|--permission-mode=*|--dangerously-skip-permissions) userperm=1; args+=("$1"); shift ;;
    *) args+=("$1"); shift ;;
  esac
done
if [ "$userperm" = 1 ]; then perm=user; mode_arg=""
elif [ "$safe" = 1 ]; then perm=safe; mode_arg=""
else perm=bypass; mode_arg=bypass; fi

mkdir -p "$D"
# Prune cache files of tabs that are no longer open. A tab is open if any tmux server of this user
# (any socket, so test servers and the cc server see each other) has a window tagged with its @ccx_id.
# Files touched in the last 10 minutes are kept, so two quick launches cannot prune each other.
live=""
for s in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
  [ -S "$s" ] || continue
  live+=$(tmux -S "$s" list-windows -a -F '#{@ccx_id}' 2>/dev/null || true)$'\n'
done
for f in "$D"/* "$D"/.[!.]*; do
  [ -e "$f" ] || continue
  b=$(basename "$f"); b=${b#.}; fid=${b%%.*}
  [[ "$fid" =~ ^[0-9]{14}-[0-9]+-[0-9]+$ ]] || continue
  grep -qxF -- "$fid" <<<"$live" && continue
  [ -n "$(find "$f" -maxdepth 0 -mmin -10 2>/dev/null)" ] && continue
  rm -rf -- "$f"
done
CCX_HOME=$P CCX_TUI=$CCX_TUI python3 "$P/ccx_settings.py" "$user_settings" $mode_arg > "$D/$id.settings.json"

# CCX_TAB_RENAME=1: statusline-tee.sh renames this tab after the session name (tabs opened before it lack it)
envs=(-e "CC_PANEL_ID=$id" -e "CC_PANEL_DIR=$dir" -e "CCX_TAB_RENAME=1" -e "CCX_HOME=$P" -e "CCX_TUI=$CCX_TUI")

if tm has-session -t "=cc" 2>/dev/null; then
  win=$(tm new-window -d -P -F '#{window_id}' -t "=cc:" -n "$name" -c "$dir" "${envs[@]}" -- "$P/left.sh" "${args[@]}")
else
  if [ -z "${CCX_NO_ATTACH:-}" ] && [ -z "${TMUX:-}" ] && [ -t 1 ]; then
    size="$(tput cols)x$(tput lines)"
  else
    size=${CCX_SIZE:-240x60}
  fi
  # A new server: the tab set "last" of the previous run is kept as "previous" before this tab replaces "last"; told once below
  if [ -s "$tabsdir/last.tsv" ] && n=$(grep -c -v '^#' "$tabsdir/last.tsv" 2>/dev/null) && [ "$n" -gt 0 ]; then
    tmp=$(mktemp "$tabsdir/.previous.XXXXXX" 2>/dev/null) \
      && sed '1s/^# ccx tabs "last"/# ccx tabs "previous" (the set "last" of the previous run)/; 1s/ccx --restore-tabs last$/ccx --restore-tabs previous/' "$tabsdir/last.tsv" > "$tmp" \
      && mv -f -- "$tmp" "$tabsdir/previous.tsv" || rm -f -- "${tmp:-}"
    hint="ccx: $n tab(s) of the previous run are saved as 'previous' · ccx --restore-tabs previous opens them again"
  fi
  win=$(tm new-session -d -P -F '#{window_id}' -s cc -n "$name" -c "$dir" -x "${size%x*}" -y "${size#*x}" "${envs[@]}" -- "$P/left.sh" "${args[@]}")
fi
# Where tmux.conf bindings find the scripts and this launcher (server options, so a test copy works too)
tm set-option -s @ccx_home "$P" 2>/dev/null || true
tm set-option -s @ccx_bin "$self" 2>/dev/null || true

gone() { echo "ccx: the Claude Code pane closed right away (claude exited); nothing to open" >&2; exit 0; }
tm set-option -w -t "$win" @ccx_id "$id" 2>/dev/null || gone
tm set-option -w -t "$win" @ccx_layout "$layout" 2>/dev/null || true
tm set-option -w -t "$win" @ccx_perm "$perm" 2>/dev/null || true
tm set-option -w -t "$win" @ccx_name0 "$name" 2>/dev/null || true
tm set-option -w -t "$win" automatic-rename off 2>/dev/null || true
left=$(tm display-message -p -t "$win" '#{pane_id}' 2>/dev/null) || gone
tm set-option -p -t "$left" @ccx_role claude 2>/dev/null || true
read -r ww wh < <(tm display-message -p -t "$win" '#{window_width} #{window_height}')

# Pane roles (@ccx_role: claude, panel, diff) let savesize.sh (C-a w) and togglediff.sh (C-a d) find the panes.
if [ "$layout" = sidebar ]; then
  side=$(cells "${CCX_SIDEBAR:-22%}" "$ww"); (( side < 36 )) && side=36
  (( side > ww - 40 )) && side=$(( ww - 40 > 20 ? ww - 40 : 20 ))
  diffh=$(cells "${CCX_DIFF:-22%}" "$wh"); (( diffh < 6 )) && diffh=6
  (( diffh > wh - 8 )) && diffh=$(( wh - 8 > 3 ? wh - 8 : 3 ))
  panel=$(tm split-window -d -h -f -l "$side" -t "$left" -c "$dir" "${envs[@]}" -P -F '#{pane_id}' -- python3 "$P/panel.py" 2>/dev/null) || gone
  diffp=$(tm split-window -d -v -l "$diffh" -t "$left" -c "$dir" "${envs[@]}" -P -F '#{pane_id}' -- python3 "$P/diffview.py" 2>/dev/null) || gone
else
  panel=$(tm split-window -d -h -l 50% -t "$left" -c "$dir" "${envs[@]}" -P -F '#{pane_id}' -- python3 "$P/panel.py" 2>/dev/null) || gone
  diffp=$(tm split-window -d -v -t "$panel" -c "$dir" "${envs[@]}" -P -F '#{pane_id}' -- python3 "$P/diffview.py" 2>/dev/null) || gone
  tm resize-pane -t "$panel" -y 14 2>/dev/null || true
fi
tm set-option -p -t "$panel" @ccx_role panel 2>/dev/null || true
tm set-option -p -t "$diffp" @ccx_role diff 2>/dev/null || true
tm select-pane -t "$left" 2>/dev/null || true
# Tab set "last" (savetabs.sh): the new tab is listed with its folder now, with its session id from the next hook run
"$P/savetabs.sh" "$SOCK" last --quiet 2>/dev/null || true

in_cc_server=0
case "${TMUX:-}" in */"$SOCK",*) in_cc_server=1 ;; esac

# Nested in another tmux server: rename the outer window (the one this shell runs in) to "ccx", turn
# automatic-rename off for that window only, and let the cc server keep it at "ccx · <active tab>"
# (outer-title.sh, run by hooks in tmux.conf; the target is kept in the server option @ccx_outer).
if [ "$in_cc_server" = 0 ] && [ -n "${TMUX:-}" ] && [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]]; then
  osock=${TMUX%%,*}
  # Not when the outer server is itself a ccx server (@ccx_home set): its tabs keep their own names.
  if [ -S "$osock" ] && [ -z "$(tmux -S "$osock" show-options -sqv @ccx_home 2>/dev/null)" ] \
     && owin=$(tmux -S "$osock" display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null); then
    tmux -S "$osock" set-option -w -t "$owin" automatic-rename off 2>/dev/null || true
    tmux -S "$osock" rename-window -t "$owin" -- ccx 2>/dev/null || true
    tm set-option -s @ccx_outer "$osock"$'\t'"$owin" 2>/dev/null || true
  fi
fi

if [ -n "${CCX_NO_ATTACH:-}" ]; then
  [ -n "${CCX_SELECT:-}" ] && tm select-window -t "$win"
  "$P/outer-title.sh" "$SOCK" 2>/dev/null || true
  echo "ccx: opened tab $name ($win, layout $layout, permissions $perm), id $id"
  [ -z "$hint" ] || echo "$hint"
elif [ "$in_cc_server" = 1 ]; then
  tm select-window -t "$win"
elif [ -n "${TMUX:-}" ]; then
  tm select-window -t "$win"
  "$P/outer-title.sh" "$SOCK" 2>/dev/null || true
  [ -z "$hint" ] || echo "$hint"
  echo "ccx: opened tab $name. You are inside another tmux server; attach with:"
  echo "  TMUX= tmux -L $SOCK attach -t cc"
else
  tm select-window -t "$win"
  [ -z "$hint" ] || tm set-option -s @ccx_hint "$hint" 2>/dev/null || true   # shown once by the client-attached hook (tmux.conf)
  exec tmux -L "$SOCK" -f "$P/tmux.conf" attach-session -t "=cc"
fi
